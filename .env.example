# The real Sophie MCP endpoint.
# Example: https://your-sophie-host.example/mcp
SOPHIE_MCP_URL=https://REPLACE-WITH-SOPHIE-MCP-ENDPOINT/mcp
SOPHIE_OAUTH_CLIENT_ID=REPLACE_ME
# Must exactly match a redirect URI registered with the Sophie OAuth app.
# Update this to https://<your-deployed-domain>/oauth/callback after deploying.
SOPHIE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/oauth/callback
SOPHIE_OAUTH_SCOPE=mcp:full
SOPHIE_OAUTH_AUTHORIZATION_URL=https://hub.sophiesociety.com/oauth/authorize
SOPHIE_OAUTH_TOKEN_URL=https://api-hub.sophiesociety.com/oauth/token

# Local proxy settings
# HOST=127.0.0.1
# PORT=8787

# PostgreSQL (AWS RDS). The pool is built from these discrete vars (see src/db.js);
# stores audit logs plus Sophie OAuth tokens/PKCE state (replaces local-file storage
# so this works on stateless/serverless hosts too).
DB_HOST=REPLACE_ME.rds.amazonaws.com
DB_PORT=5432
DB_USER=REPLACE_ME
DB_PASSWORD=REPLACE_ME
DB_NAME=REPLACE_ME
# Set to "false" only if the RDS instance does not enforce TLS.
# DB_SSL=true

# Only used as a fallback if DB_HOST is unset.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required in any environment reachable from the public internet. Callers must
# send Authorization: Bearer <PROXY_API_KEY>. Do not deploy publicly with this empty.
PROXY_API_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Optional allow-list. Empty means allow no Origin header or any Origin.
ALLOWED_ORIGINS=

# Optional static headers to send to Sophie.
# Example: {"Authorization":"Bearer YOUR_SOPHIE_TOKEN"}
# Prefer a secret manager in real environments; do not commit secrets.
UPSTREAM_HEADERS_JSON={}

# Max bytes of each Sophie response body persisted to mcp_audit_logs.response_body
# (the client still receives the full, uncapped response either way).
# RESPONSE_BODY_MAX_BYTES=200000

# Only relevant if fronting this with an OAuth-protected issuer for Claude itself
# (e.g. a Cloudflare Tunnel or API gateway). Update after the deploy domain is known.
# CLAUDE_OAUTH_ISSUER=https://your-deployed-domain
# CLAUDE_OAUTH_RESOURCE=https://your-deployed-domain/mcp/claude
